<!-- Directory.Build.props in the repository root (roslyn-analyzers step 2, build-deployment step 1) -->
<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- .NET code analysis: newest rules, recommended set as warnings -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- IDExxxx code style rules also run on build, not only in the IDE -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Needed so that IDE0005 (unnecessary usings) can run on build -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The analyzer assemblies are loaded by the compiler, not referenced as an API -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Every warning breaks the build, locally and in CI -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- CI: deterministic paths in PDBs and Source Link; set only when GitHub Actions runs the build -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
